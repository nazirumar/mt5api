APP_NAME=Nazbeen MT5 Market Data API
APP_ENV=production
APP_VERSION=1.0.0

API_HOST=127.0.0.1
API_PORT=8080
API_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
# Optional previous secret during key rotation. Both keys work until you clear it.
API_KEY_PREVIOUS=
API_KEY_HEADER=X-API-Key

LOCAL_DOMAIN=mt5.nazbeen.test
ENABLE_CADDY=true
# Optional: full path to caddy.exe. Leave blank to use PATH/common installs
# or the bundled tools\caddy.exe when present.
CADDY_PATH=
ALLOW_LAN_ACCESS=false
CORS_ORIGINS=http://mt5.nazbeen.test,http://127.0.0.1:8080

MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SERVER_TIMEZONE=
MT5_SERVER_UTC_OFFSET_MINUTES=
MT5_START_TERMINAL=true
MT5_INIT_TIMEOUT=60
MT5_RECONNECT_INTERVAL=5
MT5_MAX_RECONNECT_INTERVAL=60
MT5_MAX_RECONNECT_ATTEMPTS=10

MARKET_POLL_INTERVAL=0.5
QUOTE_STALE_MULTIPLIER=3
WATCHED_SYMBOLS=
DEFAULT_CANDLE_LIMIT=500
MAX_CANDLE_LIMIT=5000
MAX_TICK_RECORDS=10000
# Bounds for expensive history ranges and in-process request guards.
MAX_CANDLE_RANGE_DAYS=365
MAX_TICK_RANGE_DAYS=30
HISTORY_RATE_LIMIT_PER_MINUTE=30
HISTORY_MAX_CONCURRENT=2
# Completed-candle WebSocket stream.
CANDLE_STREAM_ENABLED=true
CANDLE_STREAM_MAX_SUBSCRIPTIONS=50

# Phase 18 deterministic market context engine (no AI model or trading).
# Lookbacks/bounds are in candles or seconds; ratios/percentages are documented
# in docs/PHASE_18_MARKET_CONTEXT_ENGINE.md.
CONTEXT_DEFAULT_TIMEFRAME=M5
CONTEXT_DEFAULT_LOOKBACK=100
CONTEXT_MAX_LOOKBACK=500
CONTEXT_MAX_TIMEFRAMES=4
CONTEXT_MAX_RETURN_CANDLES=25
CONTEXT_MIN_CANDLES=10
CONTEXT_SYMBOL_INFO_CACHE_SECONDS=300
CONTEXT_CANDLE_CACHE_SECONDS=30
CONTEXT_QUOTE_VERY_STALE_MULTIPLIER=6
# IANA timezone for session windows; DST is handled by zoneinfo.
CONTEXT_SESSION_TIMEZONE=UTC
# Optional override, e.g. London=7-16,New York=12-21,Sydney=21-6
CONTEXT_SESSION_WINDOWS=
# Trend: SMA fast/slow, regression slope and close-direction consistency.
CONTEXT_TREND_LOOKBACK=50
CONTEXT_TREND_FAST_SMA=10
CONTEXT_TREND_SLOW_SMA=30
CONTEXT_TREND_SLOPE_THRESHOLD=0.0005
CONTEXT_TREND_CONSISTENCY_THRESHOLD=0.6
# Volatility/regime: ATR is derived only from completed candles.
CONTEXT_ATR_PERIOD=14
CONTEXT_REGIME_VOLATILE_ATR_PERCENT=1.5
CONTEXT_REGIME_QUIET_ATR_PERCENT=0.15
CONTEXT_REGIME_EXPANSION_RATIO=1.6
CONTEXT_REGIME_CONTRACTION_RATIO=0.75
CONTEXT_REGIME_TREND_ATR_MOVE=2.0
CONTEXT_REGIME_RANGING_BODY_RATIO=0.5
CONTEXT_MOMENTUM_LOOKBACK=5
CONTEXT_MOMENTUM_WEAK_ATR_MULTIPLIER=0.3
CONTEXT_MOMENTUM_STRONG_ATR_MULTIPLIER=2.0
CONTEXT_VOLATILITY_VERY_LOW_ATR_PERCENT=0.15
CONTEXT_VOLATILITY_LOW_ATR_PERCENT=0.35
CONTEXT_VOLATILITY_HIGH_ATR_PERCENT=1.5
CONTEXT_VOLATILITY_VERY_HIGH_ATR_PERCENT=3.0
CONTEXT_VOLATILITY_PERCENTILE_WINDOW=50
# Candle structure and price-zone rules.
CONTEXT_CANDLE_STRUCTURE_LIMIT=3
CONTEXT_CANDLE_STRONG_BODY_RATIO=0.7
CONTEXT_CANDLE_SMALL_BODY_RATIO=0.15
CONTEXT_CANDLE_DOJI_RATIO=0.05
CONTEXT_CANDLE_WICK_RATIO=0.5
CONTEXT_PRICE_POSITION_LOOKBACK=50
CONTEXT_PRICE_POSITION_LOWER_ZONE_PERCENT=25
CONTEXT_PRICE_POSITION_UPPER_ZONE_PERCENT=75
# Spread is normalized in points per symbol; no cross-symbol price thresholds.
CONTEXT_SPREAD_LOOKBACK=20
CONTEXT_SPREAD_ELEVATED_RATIO=1.5
CONTEXT_SPREAD_ABNORMAL_RATIO=3.0
CONTEXT_DATA_QUALITY_MIN_SCORE=50
CONTEXT_DATA_QUALITY_GOOD_SCORE=75
CONTEXT_DATA_QUALITY_EXCELLENT_SCORE=90

# Phase 19 multi-timeframe snapshot engine (additive, sequential, bounded).
# Timeframes/limits below cap both MT5 history work and response size; see
# docs/PHASE_19_MULTI_TIMEFRAME_SNAPSHOT.md.
SNAPSHOT_DEFAULT_TIMEFRAMES=M1,M5,M15,H1,H4,D1
SNAPSHOT_MAX_TIMEFRAMES=7
SNAPSHOT_DEFAULT_LIMIT=100
SNAPSHOT_MAX_LIMIT=500
SNAPSHOT_MAX_CANDLES_PER_TIMEFRAME=100
# Retrieval-synchronization tolerances in seconds (not candle close times).
SNAPSHOT_SYNC_TIGHT_SECONDS=2
SNAPSHOT_ACCEPTABLE_SYNC_SECONDS=10
# Candle freshness thresholds expressed as multiples of timeframe duration.
SNAPSHOT_CANDLE_FRESH_CURRENT_MULTIPLIER=2
SNAPSHOT_CANDLE_FRESH_STALE_MULTIPLIER=5
# Descriptive alignment rules; not probabilities or trade signals.
SNAPSHOT_MIN_ALIGNED_TIMEFRAMES=2
SNAPSHOT_ALIGNMENT_DOMINANT_RATIO=0.6
SNAPSHOT_CONFLICT_REVERSALS=1

DATABASE_URL=sqlite:///./data/market_data.db
LOG_LEVEL=INFO
LOG_DIR=logs
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_STALE_TIMEOUT=90
# Reject browser WebSockets whose Origin is not listed in CORS_ORIGINS.
# Clients that send no Origin (native clients) are always allowed.
WEBSOCKET_CHECK_ORIGIN=true
# Deadline for first-message authentication; clients with api_key in the URL or
# header are authenticated immediately and are not subject to this timeout.
WEBSOCKET_AUTH_TIMEOUT_SECONDS=30
# Maximum simultaneous WebSocket clients; excess connections are closed with 1013.
WEBSOCKET_MAX_CLIENTS=100
# Maximum size of one inbound WebSocket frame in bytes; larger frames get 1009.
WEBSOCKET_MAX_FRAME_BYTES=65536
