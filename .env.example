APP_NAME=Nazbeen MT5 Market Data API
APP_ENV=production
APP_VERSION=1.0.0

API_HOST=127.0.0.1
API_PORT=8080
API_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
# Optional previous secret during key rotation. Both keys work until you clear it.
API_KEY_PREVIOUS=
API_KEY_HEADER=X-API-Key

LOCAL_DOMAIN=mt5.nazbeen.test
ENABLE_CADDY=true
# Optional: full path to caddy.exe. Leave blank to use PATH/common installs
# or the bundled tools\caddy.exe when present.
CADDY_PATH=
ALLOW_LAN_ACCESS=false
CORS_ORIGINS=http://mt5.nazbeen.test,http://127.0.0.1:8080

MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SERVER_TIMEZONE=
MT5_SERVER_UTC_OFFSET_MINUTES=
MT5_START_TERMINAL=true
MT5_INIT_TIMEOUT=60
MT5_RECONNECT_INTERVAL=5
MT5_MAX_RECONNECT_INTERVAL=60
MT5_MAX_RECONNECT_ATTEMPTS=10

MARKET_POLL_INTERVAL=0.5
QUOTE_STALE_MULTIPLIER=3
WATCHED_SYMBOLS=
DEFAULT_CANDLE_LIMIT=500
MAX_CANDLE_LIMIT=5000
MAX_TICK_RECORDS=10000
# Bounds for expensive history ranges and in-process request guards.
MAX_CANDLE_RANGE_DAYS=365
MAX_TICK_RANGE_DAYS=30
HISTORY_RATE_LIMIT_PER_MINUTE=30
HISTORY_MAX_CONCURRENT=2
# Completed-candle WebSocket stream.
CANDLE_STREAM_ENABLED=true
CANDLE_STREAM_MAX_SUBSCRIPTIONS=50

DATABASE_URL=sqlite:///./data/market_data.db
LOG_LEVEL=INFO
LOG_DIR=logs
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_STALE_TIMEOUT=90
